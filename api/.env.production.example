# Production preset — loaded when APP_ENV=production.
# Fill in real values. This file is gitignored; treat it as a secret.

APP_ENV=production
DEV_MODE=false

# Server
ADDR=:8080
FRONTEND_URL=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example
SESSION_SECURE_COOKIES=true

# Discord OAuth — required.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-domain.example/api/auth/callback
DISCORD_BOT_TOKEN=

# Postgres — required. Same database the Bot + Worker connect to.
DATABASE_URL=postgres://che1:che1@localhost:5432/che1?sslmode=disable

# Worker bridge — required if you run a Worker.
WORKER_URL=http://localhost:8081
WORKER_API_KEY=

# Bot-facing API key — required.
DASHBOARD_API_KEY=

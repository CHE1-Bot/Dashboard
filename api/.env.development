# Development preset — loaded automatically when APP_ENV=development (default).
# Safe to commit nothing in here is a real secret.

APP_ENV=development
DEV_MODE=true

# Server
ADDR=:8080
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
SESSION_SECURE_COOKIES=false

# Discord OAuth — leave blank to use the dev login stub (DevUser + 3 demo
# guilds). Fill these in if you want to test against real Discord auth in dev.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/callback
DISCORD_BOT_TOKEN=

# Postgres — leave blank to use the in-memory store. Point at a local DB if
# you want dev to mirror prod storage.
DATABASE_URL=

# Worker — leave blank in dev. Actions are recorded in dash_history but not
# forwarded.
WORKER_URL=
WORKER_API_KEY=

# Bot-facing API key — set when testing the Bot's dashboard.Client locally.
DASHBOARD_API_KEY=
